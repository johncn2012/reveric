# MetaArc (元弧) 商业化环境配置模板
# 品牌域名: MetaArc.COM.CN

# 基础端口与环境
PORT=8080
NODE_ENV=production
APP_URL=https://metaarc.com.cn
# 账号接口和 /account 都在主域。服务不读取 API 子域配置。

# 主业务数据库 (PostgreSQL 16)
DATABASE_URL="postgresql://metaarc_user:YourSecurePassword123@localhost:5432/metaarc_db?schema=public"

# Redis 缓存与任务队列
REDIS_URL="redis://localhost:6379"

# JWT 会话鉴权秘钥
JWT_SECRET="metaarc-super-secret-jwt-key-2026-change-in-prod"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# 已有 New-API 实例集成配置 (核心算力中枢)
# ==============================================================================
# 你的 New-API 内部网络或公网接口地址 (结尾不带 /)
NEW_API_BASE_URL="http://your-new-api-host:3000"
# 登录响应里交给客户端的算力地址。不填则响应为空，不会回落到 api 子域。
# NEW_API_PUBLIC_BASE_URL="https://your-new-api-public-host/v1"
# New-API 根管理员 API Key (用于静默创建用户、签发 Token 与充值 Quota)
NEW_API_ADMIN_KEY="sk-admin-master-key-from-new-api"
# 新注册用户默认赠送的体验额度 (500000 约等于 $1 美金算力)
NEW_API_INITIAL_QUOTA=500000

# ==============================================================================
# 云端对象存储配置 (S3 / Cloudflare R2 / 阿里云 OSS)
# ==============================================================================
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="metaarc-media-prod"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
# 绑定的公共 CDN 加速域名 (结尾不带 /)
CDN_BASE_URL="https://assets.metaarc.com.cn"

# ==============================================================================
# 客户端更新清单
# ==============================================================================
# 没有 updates/latest.json，或其中的安装包文件不在 downloads/ 时，
# GET /api/updates/latest 返回 has_update:false。不要把 signed 设为 true，除非安装包真有 Authenticode。
# UPDATE_MANIFEST_PATH="./updates/latest.json"
# DOWNLOADS_DIR="./downloads"
# 本机试接口时可改成 http://127.0.0.1:8080。线上保持主域，且该源必须真的能下载到文件。
# UPDATE_PUBLIC_BASE_URL="https://metaarc.com.cn"
# 对象存储域名不是 *.metaarc.com.cn 时，才把精确主机名加到这里。不要写 github.com。
# UPDATE_DOWNLOAD_HOSTS="downloads.example.com"

# ==============================================================================
# 支付配置 (微信支付 / 支付宝)
# ==============================================================================
# 微信支付
WECHAT_APP_ID="wx_your_app_id"
WECHAT_MCH_ID="1600000000"
WECHAT_API_V3_KEY="your-wechat-api-v3-secret-key"
WECHAT_SERIAL_NO="your-mch-certificate-serial-no"

# 支付宝
ALIPAY_APP_ID="2021000000000000"
ALIPAY_PRIVATE_KEY="your-alipay-private-key"
ALIPAY_PUBLIC_KEY="alipay-public-key"
